# DarkCloud EMS — Production Environment Variables
# Copy to .env and fill in values before deployment

# ── Database (auto-generated by CDK in Secrets Manager) ──
DATABASE_URL="postgresql://<username>:<password>@<rds-endpoint>:5432/darkcloud_ems?schema=public"

# ── Authentication ──
BETTER_AUTH_SECRET="<generate-a-random-32-char-string>"
BETTER_AUTH_URL="https://app.yourdomain.com"

# ── Server ──
PORT=3000
NODE_ENV=production
CORS_ORIGIN="https://app.yourdomain.com"

# ── Cloudflare (stored in AWS Secrets Manager, not here) ──
# TUNNEL_TOKEN is injected into the cloudflared ECS task from Secrets Manager
# Secret name: darkcloud/<environment>/cloudflare-tunnel-token

# ── AWS (for CI/CD) ──
# AWS_REGION=ap-southeast-1
# AWS_ACCOUNT_ID=<your-aws-account-id>
